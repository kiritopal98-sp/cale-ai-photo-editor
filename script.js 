const imageInput = document.getElementById("imageInput");
const originalImage = document.getElementById("originalImage");
const resultImage = document.getElementById("resultImage");
const promptInput = document.getElementById("promptInput");

const editButton = document.getElementById("editButton");
const downloadButton = document.getElementById("downloadButton");
const resultPlaceholder = document.getElementById("resultPlaceholder");

let uploadedImage = null;

// IMAGE UPLOAD
imageInput.addEventListener("change", function () {
  const file = this.files[0];

  if (!file) return;

  if (!file.type.startsWith("image/")) {
    alert("Please select an image file.");
    return;
  }

  uploadedImage = URL.createObjectURL(file);

  originalImage.src = uploadedImage;
  originalImage.style.display = "block";

  resultImage.style.display = "none";
  downloadButton.style.display = "none";

  resultPlaceholder.style.display = "block";
  resultPlaceholder.textContent = "Your photo is ready!";
});

// PREPARE EDIT
editButton.addEventListener("click", function () {
  if (!uploadedImage) {
    alert("Please upload a photo first!");
    return;
  }

  if (!promptInput.value.trim()) {
    alert("Please describe your photo edit!");
    return;
  }

  resultImage.src = uploadedImage;
  resultImage.style.display = "block";

  resultPlaceholder.style.display = "none";
  downloadButton.style.display = "block";

  alert("Preview ready! AI editing will be connected later.");
});

// DOWNLOAD PHOTO
downloadButton.addEventListener("click", function () {
  if (!uploadedImage) return;

  const link = document.createElement("a");

  link.href = uploadedImage;
  link.download = "cale-ai-photo.png";

  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
});

// INITIAL SETTINGS
downloadButton.style.display = "none";
resultImage.style.display = "none";